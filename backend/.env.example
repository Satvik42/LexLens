# ---- Application ----
APP_ENV=development                 # development | production
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./lexlens.db
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=20
DOCUMENT_RETENTION_HOURS=24

# ---- Authentication (Supabase) ----
# Legacy HS256 projects: set SUPABASE_JWT_SECRET.
# Projects using asymmetric signing keys: set SUPABASE_JWKS_URL
#   e.g. https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# Development-only sign-in (never enabled when APP_ENV=production)
AUTH_DEV_LOGIN_ENABLED=true
AUTH_DEV_JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# ---- Google Cloud ----
GCP_PROJECT_ID=
# Cloud Storage bucket for uploaded documents. Leave empty to use LOCAL_STORAGE_DIR.
GCS_BUCKET=
LOCAL_STORAGE_DIR=./.local_storage
# Document AI (OCR / Layout processor). Leave PROCESSOR_ID empty to use the local parser fallback.
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=
# Path to a service-account JSON is picked up via GOOGLE_APPLICATION_CREDENTIALS
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.8-flash
# Used in order when the primary model returns 503 or 429.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash
